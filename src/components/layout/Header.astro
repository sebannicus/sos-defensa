---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/conocenos', label: 'Conócenos' },
  { href: '/conoce-tus-derechos', label: 'Conoce tus Derechos' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 border-b border-[#232326] bg-[#0E0E10]/95 backdrop-blur-sm">
  <nav class="max-w-6xl mx-auto px-4 md:px-6 flex items-center justify-between h-16 md:h-20">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/logo.png" alt="SOS Defensa" class="h-10 w-auto" />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`text-sm font-medium transition-colors ${
              currentPath === href
                ? 'text-[#C3A75D]'
                : 'text-[#BDBDBD] hover:text-[#F4F4F4]'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA -->
    <a
      href="https://wa.me/56998078460?text=Hola%2C%20quiero%20una%20consulta%20gratuita"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden lg:inline-flex items-center gap-2 btn-primary px-5 py-2.5 rounded-lg text-sm"
    >
      Consulta Gratuita
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú"
      class="lg:hidden p-2 text-[#BDBDBD]"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#232326] bg-[#0E0E10]">
    <ul class="flex flex-col px-4 py-4 gap-1">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              currentPath === href
                ? 'text-[#C3A75D] bg-[#17171A]'
                : 'text-[#BDBDBD] hover:text-[#F4F4F4] hover:bg-[#17171A]'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="https://wa.me/56998078460?text=Hola%2C%20quiero%20una%20consulta%20gratuita"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center btn-primary px-4 py-3 rounded-lg text-sm"
        >
          Consulta Gratuita — Sin Costo
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
