---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/conocenos', label: 'Conócenos' },
  { href: '/conoce-tus-derechos', label: 'Conoce tus Derechos' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 border-b border-transparent">
  <nav class="max-w-6xl mx-auto px-4 md:px-6 flex items-center justify-between h-18 md:h-22 py-3">

    <!-- Logo + nombre -->
    <a href="/" class="flex items-center gap-3 shrink-0 group">
      <img
        src="/logo.png"
        alt="SOS Defensa"
        class="h-12 md:h-14 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <div class="leading-tight">
        <p class="text-[var(--color-text-primary)] font-['Playfair_Display'] font-bold text-base md:text-lg leading-none">SOS Defensa</p>
        <p class="text-[var(--color-accent)] text-xs font-medium tracking-wide">Abogadas</p>
      </div>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`text-sm font-medium transition-colors relative group ${
              currentPath === href
                ? 'text-[var(--color-accent)]'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]'
            }`}
          >
            {label}
            <span class={`absolute -bottom-1 left-0 h-0.5 bg-[var(--color-accent)] transition-all duration-300 ${currentPath === href ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop: toggle + CTA -->
    <div class="hidden lg:flex items-center gap-3">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="w-9 h-9 rounded-full border border-[var(--color-bg-hover)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-all duration-200"
      >
        <!-- Sol (visible en dark mode) -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m8.66-10H21M3 12H2m14.95 5.66l-.71-.71M7.76 7.76l-.71-.71m9.9 0l-.71.71M7.76 16.24l-.71.71M12 7a5 5 0 100 10A5 5 0 0012 7z"/>
        </svg>
        <!-- Luna (visible en light mode) -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
        </svg>
      </button>

      <a
        href="https://wa.me/56995630415?text=Hola%2C%20quiero%20agendar%20una%20hora"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 btn-primary px-5 py-2.5 rounded-lg text-sm"
      >
        Agenda tu hora
      </a>
    </div>

    <!-- Mobile: toggle + hamburger -->
    <div class="lg:hidden flex items-center gap-2">
      <button
        id="theme-toggle-mobile"
        aria-label="Cambiar tema"
        class="w-8 h-8 rounded-full border border-[var(--color-bg-hover)] flex items-center justify-center text-[var(--color-text-muted)]"
      >
        <svg id="icon-sun-mobile" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m8.66-10H21M3 12H2m14.95 5.66l-.71-.71M7.76 7.76l-.71-.71m9.9 0l-.71.71M7.76 16.24l-.71.71M12 7a5 5 0 100 10A5 5 0 0012 7z"/>
        </svg>
        <svg id="icon-moon-mobile" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
        </svg>
      </button>
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        class="p-2 text-[var(--color-text-secondary)]"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-bg-hover)] bg-[var(--color-bg)]">
    <ul class="flex flex-col px-4 py-4 gap-1">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              currentPath === href
                ? 'text-[var(--color-accent)] bg-[var(--color-bg-surface)]'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-bg-surface)]'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="https://wa.me/56995630415?text=Hola%2C%20quiero%20agendar%20una%20hora"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center btn-primary px-4 py-3 rounded-lg text-sm"
        >
          Agendar por WhatsApp
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header    = document.getElementById('site-header');
  const toggle    = document.getElementById('menu-toggle');
  const menu      = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // ─── Scroll: fondo del header según tema ───
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 60) {
      const theme = document.documentElement.getAttribute('data-theme');
      header.style.backgroundColor = theme === 'light'
        ? 'rgba(250,250,247,0.97)'
        : 'rgba(14,14,16,0.97)';
      header.style.backdropFilter = 'blur(12px)';
      header.style.borderBottomColor = theme === 'light' ? '#E8E3DC' : '#232326';
    } else {
      header.style.backgroundColor = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.borderBottomColor = 'transparent';
    }
  }, { passive: true });

  // ─── Mobile menu toggle ───
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // ─── Theme toggle ───
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('sos-theme', theme);

    // Iconos desktop
    const sun  = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    const sunM  = document.getElementById('icon-sun-mobile');
    const moonM = document.getElementById('icon-moon-mobile');

    if (theme === 'light') {
      sun?.classList.add('hidden');
      moon?.classList.remove('hidden');
      sunM?.classList.add('hidden');
      moonM?.classList.remove('hidden');
    } else {
      sun?.classList.remove('hidden');
      moon?.classList.add('hidden');
      sunM?.classList.remove('hidden');
      moonM?.classList.add('hidden');
    }

    // Re-aplicar fondo del header si está scrolleado
    if (header && window.scrollY > 60) {
      header.style.backgroundColor = theme === 'light'
        ? 'rgba(250,250,247,0.97)'
        : 'rgba(14,14,16,0.97)';
      header.style.borderBottomColor = theme === 'light' ? '#E8E3DC' : '#232326';
    }
  }

  // Inicializar iconos al cargar
  const savedTheme = localStorage.getItem('sos-theme') || 'dark';
  applyTheme(savedTheme);

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });

  document.getElementById('theme-toggle-mobile')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>
