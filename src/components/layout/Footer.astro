---
const year = new Date().getFullYear();
---

<footer class="bg-[#17171A] border-t border-[#232326]">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">

      <!-- Brand -->
      <div>
        <img src="/logo.png" alt="SOS Defensa" class="h-10 w-auto mb-4" />
        <p class="text-[#8C8C8C] text-sm leading-relaxed">
          Estudio jurídico especializado en derecho laboral y familiar.<br />
          Región de Coquimbo, Chile.
        </p>
        <a
          href="https://www.instagram.com/sosdefensa/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-4 text-[#C3A75D] text-sm hover:text-[#E2C98A] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @sosdefensa
        </a>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-[#F4F4F4] font-semibold text-sm mb-4">Navegación</h3>
        <ul class="space-y-2">
          {[
            { href: '/', label: 'Inicio' },
            { href: '/servicios', label: 'Servicios' },
            { href: '/conocenos', label: 'Conócenos' },
            { href: '/conoce-tus-derechos', label: 'Conoce tus Derechos' },
            { href: '/contacto', label: 'Contacto' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-[#8C8C8C] text-sm hover:text-[#C3A75D] transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-[#F4F4F4] font-semibold text-sm mb-4">Contacto</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="https://wa.me/56998078460?text=Hola%2C%20quiero%20una%20consulta%20gratuita"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[#8C8C8C] text-sm hover:text-[#C3A75D] transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.112 1.526 5.837L.057 23.854l6.187-1.621A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.214-3.724.977.994-3.636-.234-.374A9.778 9.778 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182c5.42 0 9.818 4.398 9.818 9.818 0 5.42-4.398 9.818-9.818 9.818z"/>
              </svg>
              +56 9 9807 8460
            </a>
          </li>
          <li class="text-[#8C8C8C] text-sm">
            Región de Coquimbo, Chile
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#232326] pt-6 flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-[#8C8C8C] text-xs">
        &copy; {year} SOS Defensa — Todos los derechos reservados.
      </p>
      <p class="text-[#8C8C8C] text-xs">
        Diseño por <span class="text-[#C3A75D]">Gautama Digital</span>
      </p>
    </div>
  </div>
</footer>
