---
---

<section class="relative overflow-hidden py-20 md:py-28">

  <!-- Fondo: slideshow crossfade entre ambas fotos de oficina -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div id="slide-1" class="absolute inset-0 transition-opacity duration-1800 ease-in-out opacity-100">
      <img
        src="/fotos-oficina/oficina_1.webp"
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
    </div>
    <div id="slide-2" class="absolute inset-0 transition-opacity duration-1800 ease-in-out opacity-0">
      <img
        src="/fotos-oficina/oficina_2.webp"
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
    </div>
    <!-- Overlays oscuros para mantener legibilidad del texto -->
    <div class="absolute inset-0 bg-linear-to-r from-[#0E0E10]/95 via-[#0E0E10]/80 to-[#0E0E10]/55"></div>
    <div class="absolute inset-0 bg-linear-to-t from-[#0E0E10]/60 to-transparent"></div>
  </div>

  <!-- Decorativos -->
  <div class="absolute left-0 top-0 w-1 h-full bg-linear-to-b from-transparent via-[#C3A75D]/40 to-transparent pointer-events-none"></div>
  <div class="absolute right-[8%] top-1/2 -translate-y-1/2 w-100 h-100 bg-[#C3A75D]/06 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Info -->
      <div class="reveal-left">
        <p class="text-[#C3A75D] text-xs font-semibold tracking-[0.3em] uppercase mb-4">Ven a visitarnos</p>
        <h2 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">
          Nuestra oficina<br />en La Serena
        </h2>
        <p class="text-white/70 text-sm md:text-base leading-relaxed mb-10 max-w-md">
          Te atendemos en persona en nuestra oficina. También ofrecemos consultas online por Zoom en horario vespertino para tu comodidad.
        </p>

        <!-- Info cards -->
        <div class="space-y-4">

          <!-- Dirección -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#C3A75D]/15 border border-[#C3A75D]/30 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#C3A75D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">Dirección</p>
              <!-- ⚠️ Actualizar con dirección exacta -->
              <p class="text-white/65 text-sm">Av. Balmaceda 391, of. 220, Edificio Italia, La Serena</p>
              <a
                href="https://maps.google.com/?q=Avenida+Balmaceda+391+La+Serena+Chile"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#C3A75D] text-xs font-medium hover:text-[#E2C98A] transition-colors mt-0.5 inline-block"
              >
                Ver en Google Maps →
              </a>
            </div>
          </div>

          <!-- Horario -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#C3A75D]/15 border border-[#C3A75D]/30 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#C3A75D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">Horario de atención</p>
              <p class="text-white/65 text-sm">Lunes a Viernes · 9:00 – 19:00 hrs</p>
              <p class="text-[#C3A75D] text-xs font-medium mt-0.5">Zoom vespertino · 19:00 – 21:00 hrs</p>
            </div>
          </div>

          <!-- Teléfono -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#C3A75D]/15 border border-[#C3A75D]/30 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#C3A75D]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.112 1.526 5.837L.057 23.854l6.187-1.621A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.214-3.724.977.994-3.636-.234-.374A9.778 9.778 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182c5.42 0 9.818 4.398 9.818 9.818 0 5.42-4.398 9.818-9.818 9.818z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">WhatsApp directo</p>
              <a href="https://wa.me/56995630415" class="text-white/65 text-sm hover:text-white transition-colors">+56 9 9563 0415</a>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-10">
          <a
            href="https://wa.me/56995630415?text=Hola%2C%20quiero%20agendar%20una%20visita%20presencial"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 btn-primary px-6 py-3.5 rounded-xl text-sm font-semibold"
          >
            Agendar visita presencial
          </a>
        </div>
      </div>

      <!-- Foto de oficina con slideshow + card exterior (desktop) -->
      <div class="reveal-right hidden lg:block">
        <div class="relative h-120 xl:h-130">

          <!-- Foto principal (crossfade) -->
          <div class="absolute inset-0 rounded-2xl overflow-hidden border border-white/10 shadow-[0_24px_60px_rgba(0,0,0,0.5)]">
            <div id="card-slide-1" class="absolute inset-0 transition-opacity duration-1800 ease-in-out opacity-100">
              <img
                src="/fotos-oficina/oficina_1.webp"
                alt="Oficina SOS Defensa en La Serena"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div id="card-slide-2" class="absolute inset-0 transition-opacity duration-1800 ease-in-out opacity-0">
              <img
                src="/fotos-oficina/oficina_2.webp"
                alt="Oficina SOS Defensa"
                class="w-full h-full object-cover"
                        loading="lazy"
              />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/30 to-transparent"></div>
          </div>

          <!-- Badge sobre la foto -->
          <div class="absolute bottom-5 left-5 right-5 bg-[#0E0E10]/80 backdrop-blur-sm border border-[#C3A75D]/25 rounded-xl px-5 py-4 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-[#C3A75D] animate-pulse shrink-0"></div>
            <div>
              <p class="text-white text-sm font-semibold">Atención presencial disponible</p>
              <p class="text-white/55 text-xs">Av. Balmaceda 391, of. 220 · La Serena</p>
            </div>
          </div>

          <!-- Decorativo dorado -->
          <div class="absolute -top-3 -right-3 w-24 h-24 border-t-2 border-r-2 border-[#C3A75D]/40 rounded-tr-2xl pointer-events-none"></div>
          <div class="absolute -bottom-3 -left-3 w-24 h-24 border-b-2 border-l-2 border-[#C3A75D]/40 rounded-bl-2xl pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let current = 1;
  const s1 = document.getElementById('slide-1');
  const s2 = document.getElementById('slide-2');
  const c1 = document.getElementById('card-slide-1');
  const c2 = document.getElementById('card-slide-2');

  function toggle() {
    if (current === 1) {
      s1?.classList.remove('opacity-100'); s1?.classList.add('opacity-0');
      s2?.classList.remove('opacity-0');   s2?.classList.add('opacity-100');
      c1?.classList.remove('opacity-100'); c1?.classList.add('opacity-0');
      c2?.classList.remove('opacity-0');   c2?.classList.add('opacity-100');
      current = 2;
    } else {
      s2?.classList.remove('opacity-100'); s2?.classList.add('opacity-0');
      s1?.classList.remove('opacity-0');   s1?.classList.add('opacity-100');
      c2?.classList.remove('opacity-100'); c2?.classList.add('opacity-0');
      c1?.classList.remove('opacity-0');   c1?.classList.add('opacity-100');
      current = 1;
    }
  }

  setInterval(toggle, 4500);
</script>
