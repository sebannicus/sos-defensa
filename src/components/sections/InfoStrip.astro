---
const items = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
    texto: 'Respuesta inmediata por WhatsApp',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
    texto: 'Agendamiento fácil y rápido',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/></svg>`,
    texto: 'Zoom · 19:00–21:00 hrs',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    texto: 'La Serena y Coquimbo',
  },
];
---

<div class="bg-(--color-bg-surface) border-y border-(--color-bg-hover)">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-3 md:py-3.5">
    <!-- Mobile: 2x2 grid | Desktop: fila única -->
    <div class="grid grid-cols-2 md:flex md:items-center md:justify-center gap-x-4 gap-y-2.5 md:gap-x-8 md:gap-y-0">
      {items.map((item, i) => (
        <>
          <div class="flex items-center gap-2 text-(--color-text-secondary) text-xs font-medium justify-center md:justify-start">
            <span class="text-(--color-accent)" set:html={item.icon} />
            <span>{item.texto}</span>
          </div>
          {i < items.length - 1 && (
            <span class="hidden md:block w-px h-4 bg-(--color-bg-hover)"></span>
          )}
        </>
      ))}
    </div>
  </div>
</div>
