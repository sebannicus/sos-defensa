---
const WA_NUMBER = '56995630415';
---

<!-- Gradient border wrapper -->
<div class="relative rounded-2xl p-[1px] shadow-[0_8px_40px_rgba(195,167,93,0.14)]"
     style="background: linear-gradient(145deg, #6A5020 0%, #C3A75D 42%, #E2C98A 62%, #5A4018 100%);">
  <div class="rounded-2xl overflow-hidden" style="background: #101012;">

    <!-- ─── HEADER ─── -->
    <div class="flex items-center gap-3 px-5 py-4"
         style="background: linear-gradient(180deg, rgba(195,167,93,0.07) 0%, transparent 100%); border-bottom: 1px solid rgba(255,255,255,0.06);">
      <!-- Avatar logo -->
      <div class="relative shrink-0">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-[#C3A75D]/35 bg-[#1A1A1D] flex items-center justify-center">
          <img src="/logo.png" alt="SOS Defensa" class="w-7 h-7 object-contain" loading="eager" />
        </div>
        <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-[#25D366] rounded-full border-2 border-[#101012]"></span>
      </div>
      <!-- Info -->
      <div class="flex-1 min-w-0">
        <p class="text-[#F4F4F4] text-sm font-semibold leading-tight">SOS Defensa</p>
        <p class="text-[#25D366] text-[11px] font-medium mt-0.5">Disponible ahora</p>
      </div>
      <!-- Step badge (se muestra desde paso 1) -->
      <div id="bot-step-badge" class="hidden">
        <span id="bot-step-text"
              class="text-[#C3A75D] text-[11px] font-semibold bg-[#C3A75D]/10 border border-[#C3A75D]/22 rounded-full px-2.5 py-1 whitespace-nowrap">
        </span>
      </div>
      <!-- Restart -->
      <button id="bot-restart"
              class="text-[#3A3A3E] hover:text-[#8C8C8C] transition-colors hidden ml-1 shrink-0"
              title="Reiniciar">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
      </button>
    </div>

    <!-- ─── MENSAJES ─── -->
    <div id="bot-messages"
         class="px-4 py-5 space-y-3.5 min-h-[260px] max-h-[340px] overflow-y-auto scroll-smooth"
    ></div>

    <!-- ─── OPCIONES ─── -->
    <div id="bot-options"
         class="px-4 pb-4 pt-3 min-h-[68px]"
         style="border-top: 1px solid rgba(255,255,255,0.056);"
    ></div>

    <!-- ─── TRUST SIGNAL ─── -->
    <div class="flex items-center justify-center gap-1.5 px-4 py-2"
         style="border-top: 1px solid rgba(255,255,255,0.034);">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#3A3A3E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <p class="text-[#3A3A3E] text-[10px] font-medium tracking-wide">Tu información es 100% confidencial</p>
    </div>

  </div>
</div>

<script is:inline define:vars={{ WA_NUMBER }}>
  const messagesEl = document.getElementById('bot-messages');
  const optionsEl  = document.getElementById('bot-options');
  const restartBtn = document.getElementById('bot-restart');
  const stepBadge  = document.getElementById('bot-step-badge');
  const stepText   = document.getElementById('bot-step-text');
  const state = { answers: {} };

  const STEP_LABELS = {
    area: 'Paso 1 de 6', sit_laboral: 'Paso 2 de 6', sit_familiar: 'Paso 2 de 6', sit_civil: 'Paso 2 de 6',
    tiempo: 'Paso 3 de 6', docs: 'Paso 4 de 6', ciudad: 'Paso 5 de 6', nombre: 'Paso 6 de 6',
  };

  function updateStepBadge(stepId) {
    if (!stepBadge || !stepText) return;
    const label = STEP_LABELS[stepId];
    if (!label) { stepBadge.classList.add('hidden'); return; }
    stepBadge.classList.remove('hidden');
    stepText.textContent = label;
  }

  const ICON_BOT = `
    <div class="w-7 h-7 rounded-full overflow-hidden border border-[#C3A75D]/28 bg-[#1A1A1D] flex items-center justify-center shrink-0 mt-0.5">
      <img src="/logo.png" alt="" class="w-5 h-5 object-contain" />
    </div>`;

  const steps = {
    intro: {
      bot: '¡Hola! 👋 Soy la asistente de SOS Defensa.\n\nTe haré 6 preguntas rápidas para conectarte con la abogada indicada.',
      options: [{ label: '▶ Comenzar', value: null, next: 'area' }]
    },
    area: {
      bot: '¿Tu consulta es de qué área del derecho?',
      key: 'area',
      options: [
        { label: '⚖️ Derecho Laboral',   value: 'Laboral',  next: 'sit_laboral' },
        { label: '👨‍👩‍👧 Derecho Familiar', value: 'Familiar', next: 'sit_familiar' },
        { label: '🏛️ Derecho Civil',      value: 'Civil',    next: 'sit_civil' }
      ]
    },
    sit_laboral: {
      bot: '¿Qué describe mejor tu situación?',
      key: 'situacion',
      options: [
        { label: 'Despido injustificado',    value: 'Despido injustificado',    next: 'tiempo' },
        { label: 'Acoso laboral',            value: 'Acoso laboral',            next: 'tiempo' },
        { label: 'Cotizaciones no pagadas',  value: 'Cotizaciones no pagadas',  next: 'tiempo' },
        { label: 'Accidente del trabajo',    value: 'Accidente del trabajo',    next: 'tiempo' },
        { label: 'Otra situación',           value: 'Otra situación laboral',   next: 'tiempo' }
      ]
    },
    sit_civil: {
      bot: '¿Qué describe mejor tu situación?',
      key: 'situacion',
      options: [
        { label: 'Sucesión / Herencia',        value: 'Sucesión y herencia',          next: 'tiempo' },
        { label: 'Partición de bienes',        value: 'Partición de bienes',          next: 'tiempo' },
        { label: 'Curatela / Tutela',          value: 'Curatela o tutela',            next: 'tiempo' },
        { label: 'Interdicción',               value: 'Interdicción',                 next: 'tiempo' },
        { label: 'Contratos',                  value: 'Contratos',                    next: 'tiempo' },
        { label: 'Indemnización de perjuicios',value: 'Indemnización de perjuicios',  next: 'tiempo' },
        { label: 'Arriendo',                   value: 'Juicio de arrendamiento',      next: 'tiempo' },
        { label: 'Estudio de títulos',         value: 'Estudio de títulos',           next: 'tiempo' },
        { label: 'Cambio de nombre',           value: 'Cambio de nombre',             next: 'tiempo' },
        { label: 'Otra situación',             value: 'Otra situación civil',         next: 'tiempo' }
      ]
    },
    sit_familiar: {
      bot: '¿Qué describe mejor tu situación?',
      key: 'situacion',
      options: [
        { label: 'Divorcio',                    value: 'Divorcio',                    next: 'tiempo' },
        { label: 'Pensión de alimentos',        value: 'Pensión de alimentos',        next: 'tiempo' },
        { label: 'Cuidado personal de hijos',   value: 'Cuidado personal de hijos',   next: 'tiempo' },
        { label: 'Relación directa y regular',  value: 'Relación directa y regular',  next: 'tiempo' },
        { label: 'Mediación familiar',          value: 'Mediación familiar',          next: 'tiempo' },
        { label: 'Otra situación',              value: 'Otra situación familiar',     next: 'tiempo' }
      ]
    },
    tiempo: {
      bot: '¿Cuándo ocurrió aproximadamente?',
      key: 'tiempo',
      options: [
        { label: 'Hace menos de 30 días', value: 'Menos de 30 días',   next: 'docs' },
        { label: 'Entre 1 y 2 meses',     value: 'Entre 1 y 2 meses', next: 'docs' },
        { label: 'Entre 2 y 6 meses',     value: 'Entre 2 y 6 meses', next: 'docs' },
        { label: 'Más de 6 meses',        value: 'Más de 6 meses',    next: 'docs' }
      ]
    },
    docs: {
      bot: '¿Tienes documentos relacionados con tu caso?\n(contrato, liquidaciones, carta de despido...)',
      key: 'documentos',
      options: [
        { label: '✅ Sí, tengo',      value: 'Tiene documentos',          next: 'ciudad' },
        { label: '📄 Tengo algunos',  value: 'Tiene algunos documentos',  next: 'ciudad' },
        { label: '❌ No tengo',        value: 'No tiene documentos',       next: 'ciudad' }
      ]
    },
    ciudad: {
      bot: '¿En qué ciudad estás?',
      key: 'ciudad',
      options: [
        { label: '📍 La Serena', value: 'La Serena', next: 'nombre' },
        { label: '📍 Coquimbo',  value: 'Coquimbo',  next: 'nombre' },
        { label: '📍 Otra',      value: 'Otra',      next: 'nombre' }
      ]
    },
    nombre: {
      bot: 'Último paso — ¿cuál es tu nombre?',
      key: 'nombre',
      type: 'text',
      placeholder: 'Tu nombre...',
      next: 'done'
    }
  };

  function scrollBottom() {
    setTimeout(() => { messagesEl.scrollTop = messagesEl.scrollHeight; }, 50);
  }

  function addBotMessage(text) {
    return new Promise(resolve => {
      const typing = document.createElement('div');
      typing.className = 'flex items-start gap-2.5';
      typing.innerHTML = `${ICON_BOT}
        <div class="bg-[#1A1A1E] border border-white/[0.07] rounded-2xl rounded-tl-sm px-5 py-3.5 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C3A75D]/60 animate-bounce" style="animation-delay:0ms"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#C3A75D]/60 animate-bounce" style="animation-delay:160ms"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#C3A75D]/60 animate-bounce" style="animation-delay:320ms"></span>
        </div>`;
      messagesEl.appendChild(typing);
      scrollBottom();

      setTimeout(() => {
        typing.remove();
        const msg = document.createElement('div');
        msg.className = 'flex items-start gap-2.5 bot-msg-in';
        msg.innerHTML = `${ICON_BOT}
          <div class="bg-[#1A1A1E] border border-white/[0.07] rounded-2xl rounded-tl-sm px-4 py-3 max-w-[86%]">
            <p class="text-[#D4D4D4] text-sm leading-relaxed">${text.replace(/\n/g, '<br>')}</p>
          </div>`;
        messagesEl.appendChild(msg);
        scrollBottom();
        resolve();
      }, 750);
    });
  }

  function addUserMessage(label) {
    const msg = document.createElement('div');
    msg.className = 'flex justify-end user-msg-in';
    msg.innerHTML = `
      <div class="rounded-2xl rounded-tr-sm px-4 py-3 max-w-[82%]"
           style="background: linear-gradient(135deg, rgba(195,167,93,0.18) 0%, rgba(138,111,47,0.12) 100%); border: 1px solid rgba(195,167,93,0.28);">
        <p class="text-[#F0F0F0] text-sm">${label}</p>
      </div>`;
    messagesEl.appendChild(msg);
    scrollBottom();
  }

  function renderOptions(step) {
    optionsEl.innerHTML = '';

    if (step.type === 'text') {
      const wrap = document.createElement('div');
      wrap.className = 'flex gap-2';
      wrap.innerHTML = `
        <input id="bot-input" type="text" placeholder="${step.placeholder || 'Escribe aquí...'}"
          class="flex-1 rounded-xl px-4 py-3 text-[#F4F4F4] text-sm placeholder-[#3A3A3E] outline-none transition-colors"
          style="background: #1A1A1E; border: 1px solid rgba(255,255,255,0.08);"
          onfocus="this.style.borderColor='rgba(195,167,93,0.45)'"
          onblur="this.style.borderColor='rgba(255,255,255,0.08)'"
        />
        <button id="bot-send"
          class="px-5 py-3 rounded-xl text-sm font-bold shrink-0 transition-all duration-150 hover:scale-[1.03] active:scale-[0.97]"
          style="background: #C3A75D; color: #0E0E10;">
          →
        </button>`;
      optionsEl.appendChild(wrap);

      const input = document.getElementById('bot-input');
      const send  = document.getElementById('bot-send');
      const submit = () => {
        const val = input.value.trim();
        if (!val) return;
        state.answers[step.key] = val;
        addUserMessage(val);
        optionsEl.innerHTML = '';
        goNext(step.next);
      };
      send.addEventListener('click', submit);
      input.addEventListener('keydown', e => { if (e.key === 'Enter') submit(); });
      setTimeout(() => input.focus(), 80);

    } else {
      const grid = document.createElement('div');
      grid.className = 'flex flex-wrap gap-2';
      step.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'px-4 py-2 rounded-full text-xs font-semibold transition-all duration-150 active:scale-[0.96] cursor-pointer';
        btn.style.cssText = 'border: 1px solid rgba(195,167,93,0.28); color: #C3A75D; background: rgba(195,167,93,0.07);';
        btn.textContent = opt.label;
        btn.addEventListener('mouseenter', () => {
          btn.style.background = 'rgba(195,167,93,0.18)';
          btn.style.borderColor = 'rgba(195,167,93,0.52)';
          btn.style.color = '#F4F4F4';
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.background = 'rgba(195,167,93,0.07)';
          btn.style.borderColor = 'rgba(195,167,93,0.28)';
          btn.style.color = '#C3A75D';
        });
        btn.addEventListener('click', () => {
          if (step.key && opt.value) state.answers[step.key] = opt.value;
          if (opt.value) addUserMessage(opt.label);
          optionsEl.innerHTML = '';
          goNext(opt.next || step.next);
        });
        grid.appendChild(btn);
      });
      optionsEl.appendChild(grid);
    }
  }

  async function goNext(nextId) {
    if (nextId === 'done') { finalize(); return; }
    const step = steps[nextId];
    if (!step) return;
    updateStepBadge(nextId);
    await addBotMessage(step.bot);
    renderOptions(step);
  }

  async function finalize() {
    if (stepBadge) stepBadge.classList.add('hidden');
    if (restartBtn) restartBtn.classList.remove('hidden');
    const a = state.answers;
    const nombre = a.nombre || 'Sin nombre';

    await addBotMessage(`¡Gracias, ${nombre}! 🙌\n\nToda tu información está lista. Toca el botón para enviarla a nuestras abogadas por WhatsApp.`);

    const texto =
`Hola SOS Defensa 👋 vengo del formulario de la web.

📋 *Resumen de mi consulta:*
• Nombre: ${nombre}
• Área: Derecho ${a.area || '-'}
• Situación: ${a.situacion || '-'}
• ¿Cuándo ocurrió?: ${a.tiempo || '-'}
• Documentos: ${a.documentos || '-'}
• Ciudad: ${a.ciudad || '-'}

Quisiera agendar una hora.`;

    const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(texto)}`;

    setTimeout(() => {
      const cta = document.createElement('div');
      cta.className = 'flex justify-center';
      cta.innerHTML = `
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 w-full justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-white transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          style="background: #25D366; box-shadow: 0 4px 20px rgba(37,211,102,0.28);">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.112 1.526 5.837L.057 23.854l6.187-1.621A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.214-3.724.977.994-3.636-.234-.374A9.778 9.778 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182c5.42 0 9.818 4.398 9.818 9.818 0 5.42-4.398 9.818-9.818 9.818z"/>
          </svg>
          Enviar consulta por WhatsApp
        </a>`;
      optionsEl.innerHTML = '';
      optionsEl.appendChild(cta);
    }, 900);
  }

  restartBtn?.addEventListener('click', () => {
    state.answers = {};
    messagesEl.innerHTML = '';
    optionsEl.innerHTML = '';
    restartBtn.classList.add('hidden');
    if (stepBadge) stepBadge.classList.add('hidden');
    boot();
  });

  async function boot() {
    const first = steps['intro'];
    await addBotMessage(first.bot);
    renderOptions(first);
  }

  boot();
</script>

<style>
  .bot-msg-in  { animation: slideIn 0.3s ease; }
  .user-msg-in { animation: slideIn 0.25s ease; }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #bot-messages { scrollbar-width: thin; scrollbar-color: #2A2A2E transparent; }
  #bot-messages::-webkit-scrollbar { width: 4px; }
  #bot-messages::-webkit-scrollbar-thumb { background: #2A2A2E; border-radius: 2px; }
</style>
