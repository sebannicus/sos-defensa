---
const testimonios = [
  {
    nombre: 'María G.',
    texto: 'Gracias a SOS Defensa, pude demandar sin dinero por adelantado y pagar el servicio cuando recibí mi indemnización. ¡Ahora tengo la tranquilidad que merezco!',
    caso: 'Despido injustificado',
  },
  {
    nombre: 'Juan P.',
    texto: 'Estaba desesperado por el maltrato en mi trabajo. Contacté a SOS Defensa y me ayudaron a demandar sin adelantar dinero. ¡Recibí mi indemnización y estoy protegido!',
    caso: 'Autodespido por acoso laboral',
  },
];
---

<section class="section-warm py-20">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="text-center mb-14">
      <h2 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold text-[#0E0E10] mb-4">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-[#232326]/70 max-w-xl mx-auto">
        Casos reales de personas que recuperaron lo que les correspondía.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14">
      {testimonios.map((t) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm">
          <!-- Estrellas -->
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#C3A75D]" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <blockquote class="text-[#17171A] text-base leading-relaxed mb-6 italic">
            "{t.texto}"
          </blockquote>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-[#0E0E10]">{t.nombre}</p>
              <p class="text-[#8C8C8C] text-sm">{t.caso}</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-[#C3A75D]/20 flex items-center justify-center">
              <span class="text-[#C3A75D] font-bold text-lg">{t.nombre.charAt(0)}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Métricas -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 text-center">
      {[
        { numero: '4', label: 'Años de experiencia' },
        { numero: '2', label: 'Abogadas especializadas' },
        { numero: '100%', label: 'Consulta gratuita' },
      ].map(({ numero, label }) => (
        <div>
          <p class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-[#0E0E10] mb-1">
            {numero}
          </p>
          <p class="text-[#232326]/70 text-sm">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
