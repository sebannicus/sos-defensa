---
const testimonios = [
  {
    nombre: 'María G.',
    texto: 'Gracias a SOS Defensa, pude demandar sin dinero por adelantado y pagar el servicio cuando recibí mi indemnización. ¡Ahora tengo la tranquilidad que merezco!',
    caso: 'Despido injustificado',
  },
  {
    nombre: 'Juan P.',
    texto: 'Estaba desesperado por el maltrato en mi trabajo. Contacté a SOS Defensa y me ayudaron a demandar sin adelantar dinero. ¡Recibí mi indemnización y estoy protegido!',
    caso: 'Autodespido por acoso laboral',
  },
];

const metricas = [
  { numero: 4, sufijo: '', label: 'Años de experiencia' },
  { numero: 2, sufijo: '', label: 'Abogadas especializadas' },
  { numero: 100, sufijo: '%', label: 'Consulta gratuita' },
];
---

<section class="section-warm py-24 reveal-section">
  <div class="max-w-6xl mx-auto px-4 md:px-6">

    <!-- Imagen + texto intro -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
      <div class="reveal-left">
        <p class="text-[#8A6F2F] text-sm font-medium mb-3">Historias reales</p>
        <h2 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold text-[#0E0E10] mb-4">
          Lo que dicen nuestros clientes
        </h2>
        <p class="text-[#232326]/70 leading-relaxed">
          Casos reales de personas que recuperaron lo que les correspondía — sin pagar un peso por adelantado.
        </p>
      </div>
      <div class="reveal-right rounded-2xl overflow-hidden aspect-video shadow-lg">
        <img
          src="https://images.unsplash.com/photo-1698047682091-782b1e5c6536?w=800&q=80&fit=crop&auto=format"
          alt="Reunión profesional de abogadas con cliente"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {testimonios.map((t, i) => (
        <div class={`reveal-up stagger-${i + 1} bg-white rounded-2xl p-8 shadow-sm`}>
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#C3A75D]" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <blockquote class="text-[#17171A] text-base leading-relaxed mb-6 italic">
            "{t.texto}"
          </blockquote>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-[#0E0E10]">{t.nombre}</p>
              <p class="text-[#8C8C8C] text-sm">{t.caso}</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-[#C3A75D]/20 flex items-center justify-center">
              <span class="text-[#C3A75D] font-bold text-lg">{t.nombre.charAt(0)}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Métricas animadas -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 text-center">
      {metricas.map(({ numero, sufijo, label }, i) => (
        <div class={`reveal-up stagger-${i + 1}`}>
          <p
            class="font-['Playfair_Display'] text-5xl md:text-6xl font-bold text-[#0E0E10] mb-1 counter"
            data-target={numero}
            data-sufijo={sufijo}
          >
            0{sufijo}
          </p>
          <p class="text-[#232326]/70 text-sm">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Contador animado al entrar en viewport
  const counters = document.querySelectorAll<HTMLElement>('.counter');

  const animateCounter = (el: HTMLElement) => {
    const target = parseInt(el.dataset.target ?? '0');
    const sufijo = el.dataset.sufijo ?? '';
    const duration = 1500;
    const steps = 40;
    const increment = target / steps;
    let current = 0;
    const timer = setInterval(() => {
      current = Math.min(current + increment, target);
      el.textContent = Math.round(current) + sufijo;
      if (current >= target) clearInterval(timer);
    }, duration / steps);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateCounter(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  counters.forEach((c) => observer.observe(c));
</script>
