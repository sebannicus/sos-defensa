<!-- Canvas de baja resolución interna; CSS lo estira a pantalla completa -->
<canvas
  id="silk-canvas"
  width="640"
  height="400"
  aria-hidden="true"
  style="position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;"
></canvas>

<script>
  const canvas = document.getElementById('silk-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('No canvas context');

  const W = 640;
  const H = 400;
  let t = 0;
  let animId = 0;

  // Interpola entre dos colores RGB
  function lerp(a: number[], b: number[], f: number): [number, number, number] {
    return [
      Math.round(a[0] + (b[0] - a[0]) * f),
      Math.round(a[1] + (b[1] - a[1]) * f),
      Math.round(a[2] + (b[2] - a[2]) * f),
    ];
  }

  // Paleta seda dorada: negro profundo → ámbar oscuro → oro SOS → crema cálida
  const stops: [number, number[]][] = [
    [0.00, [8,   8,  10]],
    [0.30, [40,  28,  8]],
    [0.55, [120, 88,  30]],
    [0.75, [195, 167, 93]],
    [1.00, [232, 220, 175]],
  ];

  function silkColor(v: number): [number, number, number] {
    for (let i = 0; i < stops.length - 1; i++) {
      const [a, ca] = stops[i];
      const [b, cb] = stops[i + 1];
      if (v <= b) {
        return lerp(ca, cb, (v - a) / (b - a));
      }
    }
    return stops[stops.length - 1][1] as [number, number, number];
  }

  // Valor de seda: capas de senos con frecuencias distintas
  function silk(x: number, y: number, t: number): number {
    return (
      Math.sin(x * 1.40 + t * 0.80) * 0.32 +
      Math.sin(y * 1.90 - t * 0.55) * 0.28 +
      Math.sin((x + y) * 1.10 + t * 1.00) * 0.20 +
      Math.sin((x - y) * 1.70 + t * 0.45) * 0.17 +
      Math.sin(Math.sqrt(x * x + y * y) * 2.20 - t * 0.85) * 0.22 +
      Math.sin(x * 0.50 - y * 2.50 + t * 0.65) * 0.15
    );
    // rango aproximado: -1.34 .. +1.34
  }

  function draw() {
    const imageData = ctx.createImageData(W, H);
    const data = imageData.data;
    const step = 2;

    for (let py = 0; py < H; py += step) {
      for (let px = 0; px < W; px += step) {
        // Coordenadas normalizadas -2.5 .. 2.5
        const x = (px / W) * 5 - 2.5;
        const y = (py / H) * 5 - 2.5;

        let v = silk(x, y, t);
        // Normalizar a 0..1
        v = (v + 1.34) / 2.68;
        v = Math.max(0, Math.min(1, v));
        // Curva de potencia: oscuros se quedan oscuros, brillos resaltan
        v = Math.pow(v, 1.65);

        const [r, g, b] = silkColor(v);

        // Rellenar bloque 2×2
        for (let dy = 0; dy < step && py + dy < H; dy++) {
          for (let dx = 0; dx < step && px + dx < W; dx++) {
            const i = ((py + dy) * W + (px + dx)) * 4;
            data[i]     = r;
            data[i + 1] = g;
            data[i + 2] = b;
            data[i + 3] = 255;
          }
        }
      }
    }

    ctx.putImageData(imageData, 0, 0);
    t += 0.006;
    animId = requestAnimationFrame(draw);
  }

  // Pausa cuando la pestaña no es visible
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      cancelAnimationFrame(animId);
    } else {
      animId = requestAnimationFrame(draw);
    }
  });

  draw();
</script>
