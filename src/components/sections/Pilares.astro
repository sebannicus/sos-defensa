---
const pilares = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    titulo: 'Honorarios transparentes',
    descripcion: 'La primera consulta es siempre gratuita. Los honorarios se acuerdan según el tipo de causa — te lo explicamos antes de empezar, sin letra chica.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    titulo: 'Especialización real',
    descripcion: 'Derecho laboral y familiar en un mismo equipo. No somos generalistas: nos especializamos en los casos que más afectan a las personas.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    titulo: 'Equipo que te entiende',
    descripcion: 'Somos un equipo 100% femenino. Escuchamos tu situación con empatía real, porque sabemos que detrás de cada caso hay una persona que necesita apoyo.',
  },
];
---

<section class="section-surface py-20 reveal-section">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pilares.map((pilar, i) => (
        <div
          class={`reveal-up stagger-${i + 1} bg-[#0E0E10] rounded-2xl p-8 border border-[#232326] hover:border-[#C3A75D]/40 hover:shadow-lg hover:shadow-[#C3A75D]/5 transition-all duration-300 group cursor-default`}
        >
          <div class="text-[#C3A75D] mb-5 transition-transform duration-300 group-hover:scale-110 w-fit" set:html={pilar.icon} />
          <h3 class="font-['Playfair_Display'] text-xl font-bold text-[#F4F4F4] mb-3">
            {pilar.titulo}
          </h3>
          <p class="text-[#BDBDBD] text-sm leading-relaxed">
            {pilar.descripcion}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
