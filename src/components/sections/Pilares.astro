---
const pilares = [
  {
    num: '01',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
    titulo: 'Respuesta inmediata',
    descripcion: 'Al escribirnos por WhatsApp, te responde directamente una abogada. El agendamiento es fácil, rápido y sin trámites complicados.',
  },
  {
    num: '02',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    titulo: 'Especialización real',
    descripcion: 'Derecho laboral y familiar en un mismo equipo. No somos generalistas: nos especializamos en los casos que más afectan a las personas.',
  },
  {
    num: '03',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    titulo: 'Equipo que te entiende',
    descripcion: 'Escuchamos tu situación con empatía real, porque sabemos que detrás de cada caso hay una persona que necesita apoyo y soluciones concretas.',
  },
];
---

<section class="section-surface py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pilares.map((pilar, i) => (
        <div class={`reveal-up stagger-${i + 1} relative bg-(--color-bg) rounded-2xl border border-(--color-bg-hover) card-lift group overflow-hidden`}>
          <!-- Gold gradient top line -->
          <div class="h-0.75 bg-linear-to-r from-[#8A6F2F] via-[#C3A75D] to-[#E2C98A]"></div>
          <div class="p-8">
            <!-- Icon + Number -->
            <div class="flex items-start justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-[#C3A75D]/10 border border-[#C3A75D]/20 flex items-center justify-center text-(--color-accent) group-hover:bg-[#C3A75D]/20 group-hover:border-[#C3A75D]/40 group-hover:scale-110 transition-all duration-300">
                <span set:html={pilar.icon} />
              </div>
              <span class="font-['Playfair_Display'] text-5xl font-bold text-(--color-accent) opacity-15 leading-none select-none">{pilar.num}</span>
            </div>
            <h3 class="font-['Playfair_Display'] text-xl font-bold text-(--color-text-primary) mb-3 group-hover:text-(--color-accent) transition-colors duration-300">
              {pilar.titulo}
            </h3>
            <p class="text-(--color-text-secondary) text-sm leading-relaxed">
              {pilar.descripcion}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
