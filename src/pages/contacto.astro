---
import Layout from '../components/layout/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout
  title="Contacto — SOS Defensa | Consulta Gratuita Coquimbo"
  description="Contáctanos para tu consulta gratuita. Derecho laboral y familiar en la Región de Coquimbo. WhatsApp +56 9 9807 8460."
>
  <Header />
  <main class="pt-20">
    <!-- Hero interior -->
    <section class="bg-[#0E0E10] py-16 border-b border-[#232326]">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <p class="text-[#C3A75D] text-sm font-medium mb-3">Estamos para ayudarte</p>
        <h1 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-[#F4F4F4] mb-4">
          Contacto
        </h1>
        <p class="text-[#BDBDBD] max-w-xl text-lg">
          La primera consulta es gratuita y sin compromiso. Cuéntanos tu situación y te orientamos.
        </p>
      </div>
    </section>

    <section class="section-warm py-20">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

          <!-- Info de contacto -->
          <div>
            <h2 class="font-['Playfair_Display'] text-2xl font-bold text-[#0E0E10] mb-8">
              Escríbenos o llámanos
            </h2>
            <div class="space-y-6">
              <a
                href="https://wa.me/56998078460?text=Hola%2C%20quiero%20una%20consulta%20gratuita"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-4 bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow"
              >
                <div class="w-12 h-12 rounded-xl bg-[#25D366] flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.112 1.526 5.837L.057 23.854l6.187-1.621A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.214-3.724.977.994-3.636-.234-.374A9.778 9.778 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182c5.42 0 9.818 4.398 9.818 9.818 0 5.42-4.398 9.818-9.818 9.818z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#0E0E10]">WhatsApp</p>
                  <p class="text-[#232326]/70 text-sm">+56 9 9807 8460</p>
                  <p class="text-[#8C8C8C] text-xs mt-1">Respuesta en menos de 24h</p>
                </div>
              </a>

              <a
                href="tel:+56998078460"
                class="flex items-start gap-4 bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow"
              >
                <div class="w-12 h-12 rounded-xl bg-[#C3A75D] flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#0E0E10]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#0E0E10]">Llamar ahora</p>
                  <p class="text-[#232326]/70 text-sm">+56 9 9807 8460</p>
                  <p class="text-[#8C8C8C] text-xs mt-1">Atención en toda la Región de Coquimbo</p>
                </div>
              </a>

              <a
                href="https://www.instagram.com/sosdefensa/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-4 bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow"
              >
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#0E0E10]">Instagram</p>
                  <p class="text-[#232326]/70 text-sm">@sosdefensa</p>
                  <p class="text-[#8C8C8C] text-xs mt-1">Síguenos para consejos legales</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Formulario -->
          <div class="bg-white rounded-2xl p-8 shadow-sm">
            <h2 class="font-['Playfair_Display'] text-xl font-bold text-[#0E0E10] mb-6">
              Cuéntanos tu caso
            </h2>
            <form
              action="https://wa.me/56998078460"
              method="get"
              id="contact-form"
              class="space-y-5"
            >
              <div>
                <label class="block text-sm font-medium text-[#0E0E10] mb-1.5">Tu nombre</label>
                <input
                  type="text"
                  name="nombre"
                  required
                  placeholder="Nombre completo"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-[#0E0E10] text-sm focus:outline-none focus:border-[#C3A75D] transition-colors"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-[#0E0E10] mb-1.5">Área legal</label>
                <select
                  name="area"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-[#0E0E10] text-sm focus:outline-none focus:border-[#C3A75D] transition-colors bg-white"
                >
                  <option value="" disabled selected>Selecciona una opción</option>
                  <option value="laboral">Derecho Laboral</option>
                  <option value="familia">Derecho de Familia</option>
                  <option value="mediacion">Mediación Familiar</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-[#0E0E10] mb-1.5">Cuéntanos brevemente tu situación</label>
                <textarea
                  name="mensaje"
                  rows="4"
                  required
                  placeholder="Describe tu situación con tus propias palabras..."
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-[#0E0E10] text-sm focus:outline-none focus:border-[#C3A75D] transition-colors resize-none"
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full btn-primary py-4 rounded-xl text-sm font-semibold"
              >
                Enviar por WhatsApp
              </button>
              <p class="text-[#8C8C8C] text-xs text-center">Sin compromiso · Consulta gratuita · Solo pagas si ganamos</p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (form.elements.namedItem('nombre') as HTMLInputElement).value;
    const area = (form.elements.namedItem('area') as HTMLSelectElement).value;
    const mensaje = (form.elements.namedItem('mensaje') as HTMLTextAreaElement).value;
    const texto = `Hola, soy ${nombre}. Mi consulta es sobre ${area}: ${mensaje}`;
    window.open(`https://wa.me/56998078460?text=${encodeURIComponent(texto)}`, '_blank');
  });
</script>
