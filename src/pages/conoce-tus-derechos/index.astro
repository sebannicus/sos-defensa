---
import Layout from '../../components/layout/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const articulosFamilia = [
  { slug: 'como-demandar-pension-alimenticia', titulo: '¿Cómo demandar por pensión alimenticia?', categoria: 'Familia' },
  { slug: 'proceso-divorcio-paso-a-paso', titulo: 'Proceso del divorcio: el paso a paso en Chile', categoria: 'Familia' },
  { slug: 'divorcio-mutuo-acuerdo-o-unilateral', titulo: 'Divorcio en Chile: ¿mutuo acuerdo o unilateral?', categoria: 'Familia' },
  { slug: 'divorcio-culposo', titulo: 'Divorcio culposo: todo lo que debes saber', categoria: 'Familia' },
  { slug: 'que-tipo-de-divorcio-me-conviene', titulo: '¿Qué tipo de divorcio me conviene?', categoria: 'Familia' },
  { slug: 'cese-de-convivencia', titulo: 'Cese de convivencia: el primer paso para tu divorcio', categoria: 'Familia' },
  { slug: 'compensacion-economica-divorcio', titulo: 'Compensación económica en el divorcio', categoria: 'Familia' },
  { slug: 'violencia-intrafamiliar-como-denunciar', titulo: 'Violencia intrafamiliar: qué hacer y cómo denunciar', categoria: 'Familia' },
];

const articulosLaboral = [
  { slug: 'que-es-el-autodespido', titulo: '¿Qué es el autodespido y cuándo aplicarlo?', categoria: 'Laboral' },
  { slug: 'despido-injustificado-como-reclamar', titulo: 'Despido injustificado: cómo reclamar tu indemnización', categoria: 'Laboral' },
  { slug: 'acoso-laboral-tus-derechos', titulo: 'Acoso laboral: tus derechos en Chile', categoria: 'Laboral' },
  { slug: 'impago-de-salarios', titulo: 'Impago de salarios: qué hacer paso a paso', categoria: 'Laboral' },
];
---

<Layout
  title="Conoce tus Derechos — SOS Defensa | Guías Legales Chile"
  description="Guías legales gratuitas sobre derecho laboral, familiar y civil en Chile. Aprende sobre despido injustificado, divorcio, pensión de alimentos y más."
>
  <Header />
  <main class="pt-20">
    <!-- Hero interior -->
    <section class="bg-(--color-bg) py-16 border-b border-(--color-bg-hover)">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <p class="text-(--color-accent) text-xs font-semibold tracking-[0.2em] uppercase mb-3">Educación legal gratuita</p>
        <h1 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-(--color-text-primary) mb-4">
          Conoce tus Derechos
        </h1>
        <p class="text-(--color-text-secondary) max-w-2xl text-lg">
          Guías escritas por nuestras abogadas para que entiendas tu situación legal con claridad, sin tecnicismos.
        </p>
      </div>
    </section>

    <!-- Derecho de Familia -->
    <section class="bg-(--color-bg) py-16">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <div class="flex items-center gap-3 mb-8 reveal-up">
          <div class="w-1 h-8 bg-linear-to-b from-[#C3A75D] to-[#8A6F2F] rounded-full"></div>
          <h2 class="font-['Playfair_Display'] text-2xl font-bold text-(--color-text-primary)">Derecho de Familia</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {articulosFamilia.map((art, i) => (
            <a
              href={`/conoce-tus-derechos/${art.slug}`}
              class={`reveal-up stagger-${(i % 4) + 1} group flex flex-col bg-(--color-bg-surface) rounded-xl overflow-hidden border border-(--color-bg-hover) card-lift`}
            >
              <div class="h-0.75 bg-linear-to-r from-[#8A6F2F] via-[#C3A75D] to-[#E2C98A]"></div>
              <div class="flex items-center justify-between p-5">
                <div>
                  <span class="text-(--color-accent) text-xs font-semibold tracking-wide mb-1 block">{art.categoria}</span>
                  <h3 class="text-(--color-text-primary) font-medium text-sm group-hover:text-(--color-accent) transition-colors duration-200">
                    {art.titulo}
                  </h3>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-(--color-text-muted) group-hover:text-(--color-accent) group-hover:translate-x-1 transition-all duration-200 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Derecho Laboral -->
    <section class="section-surface py-16">
      <div class="max-w-6xl mx-auto px-4 md:px-6">
        <div class="flex items-center gap-3 mb-8 reveal-up">
          <div class="w-1 h-8 bg-linear-to-b from-[#C3A75D] to-[#8A6F2F] rounded-full"></div>
          <h2 class="font-['Playfair_Display'] text-2xl font-bold text-(--color-text-primary)">Derecho Laboral</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {articulosLaboral.map((art, i) => (
            <a
              href={`/conoce-tus-derechos/${art.slug}`}
              class={`reveal-up stagger-${i + 1} group flex flex-col bg-(--color-bg) rounded-xl overflow-hidden border border-(--color-bg-hover) card-lift`}
            >
              <div class="h-0.75 bg-linear-to-r from-[#8A6F2F] via-[#C3A75D] to-[#E2C98A]"></div>
              <div class="flex items-center justify-between p-5">
                <div>
                  <span class="text-(--color-accent) text-xs font-semibold tracking-wide mb-1 block">{art.categoria}</span>
                  <h3 class="text-(--color-text-primary) font-medium text-sm group-hover:text-(--color-accent) transition-colors duration-200">
                    {art.titulo}
                  </h3>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-(--color-text-muted) group-hover:text-(--color-accent) group-hover:translate-x-1 transition-all duration-200 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-(--color-bg) py-16">
      <div class="max-w-3xl mx-auto px-4 md:px-6 text-center reveal-up">
        <p class="text-(--color-text-secondary) mb-6">¿Tu situación no está cubierta aquí? Cuéntanos tu caso.</p>
        <a
          href="https://wa.me/56995630415?text=Hola%2C%20quiero%20agendar%20una%20hora"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 btn-primary px-6 py-3.5 rounded-xl text-sm font-semibold"
        >
          Agenda tu hora por WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
